# ==============================================================================
# LumaCV Environment Configuration
# Copy this file to .env.local for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Providers (5-way failover chain: Gemini -> Groq -> Mistral -> OpenRouter
# -> OpenAI -> GitHub Models). Provide AT LEAST ONE key; all are optional beyond
# that. Most offer free tiers, so configuring several gives real redundancy —
# if one provider is down or rate-limited, the pipeline fails over to the next.
# ------------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey
# Models: gemini-2.5-flash, gemini-flash-latest, gemini-2.5-flash-lite
GEMINI_API_KEY=

# Groq Cloud: https://console.groq.com/keys
# Models: qwen/qwen3.6-27b, openai/gpt-oss-120b, groq/compound-mini
GROQ_API_KEY=

# Mistral AI: https://console.mistral.ai/api-keys
# Models: codestral-latest, ministral-14b-latest, ministral-8b-latest
MISTRAL_API_KEY=

# OpenRouter (free-tier models): https://openrouter.ai/keys
# Models: nvidia/nemotron-3-super-120b-a12b:free, nvidia/nemotron-3.5-lightning:free
OPENROUTER_API_KEY=

# GitHub Models (free with a GitHub account): https://github.com/settings/tokens
# Needs a fine-grained PAT with "Models" access. Models: gpt-4o-mini, Meta-Llama-3.1-8B-Instruct
GITHUB_MODELS_TOKEN=

# Production canonical URL: https://lumacv.sahilbansal.net
# Local development: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://lumacv.sahilbansal.net

# ------------------------------------------------------------------------------
# 3. Supabase (For user accounts and CV persistence)
# Required for user authentication (Email/Password) and saving resumes.
# Get credentials from your Supabase project dashboard -> Settings -> API.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUMES_BUCKET=resumes

# ------------------------------------------------------------------------------
# 4. Upstash Redis (Optional: For API rate limiting)
# Leave empty to bypass rate limiting in local development.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 4b. Async PDF Compile Worker (Optional: Upstash QStash)
# Powers the background compile-retry pipeline (app/api/v1/internal/*).
# QStash is provisioned per-region — copy QSTASH_URL exactly from your own
# Upstash QStash console Quickstart, it is not a fixed global endpoint.
# COMPILE_WORKER_SECRET gates those internal endpoints — set a strong random
# value in production. Without it (and without valid QStash signing keys),
# those endpoints reject every request rather than silently allowing access.
# ------------------------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_URL=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
COMPILE_WORKER_SECRET=

# ------------------------------------------------------------------------------
# 4c. Feedback Email (Optional: Resend)
# Powers transactional email delivery for the feedback widget (app/api/v1/feedback).
# Without RESEND_API_KEY, feedback still saves to Supabase/local file but no
# email is sent to the project owner.
# FEEDBACK_NOTIFICATION_EMAIL / FEEDBACK_RECIPIENT_EMAIL are interchangeable
# aliases for the recipient address (first one set wins); default recipient
# and sender otherwise fall back to a hardcoded LumaCV address.
# ------------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FEEDBACK_FROM_EMAIL=
FEEDBACK_NOTIFICATION_EMAIL=
FEEDBACK_RECIPIENT_EMAIL=

# ------------------------------------------------------------------------------
# 5. Payment & Support (Billing Page)
# UPI QR code generation and Buy Me a Coffee button.
# These are NEXT_PUBLIC_ so they are available client-side (not secrets).
# ------------------------------------------------------------------------------
# Your UPI Virtual Payment Address (VPA / UPI ID), e.g. yourname@upi
NEXT_PUBLIC_UPI_ID=

# Your Buy Me a Coffee profile URL, e.g. https://buymeacoffee.com/yourname
NEXT_PUBLIC_BUYMEACOFFEE_URL=https://buymeacoffee.com/sahilbansal

# Your GitHub Sponsors URL
NEXT_PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/sahilbnsll

