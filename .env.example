# ==============================================================================
# LumaCV Environment Configuration
# Copy this file to .env.local for local development
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Providers (Google Gemini & Groq)
# Provide AT LEAST ONE of GEMINI_API_KEY or GROQ_API_KEY.
# Both offer high-quota free tiers.
# ------------------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com/app/apikey
# Models: gemini-2.5-flash, gemini-flash-latest, gemini-2.5-flash-lite
GEMINI_API_KEY=

# Groq Cloud: https://console.groq.com/keys
# Models: qwen/qwen3.6-27b, openai/gpt-oss-120b
GROQ_API_KEY=

# ------------------------------------------------------------------------------
# 2. Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Supabase (For user accounts and CV persistence)
# Required for user authentication (Email/Password) and saving resumes.
# Get credentials from your Supabase project dashboard -> Settings -> API.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_RESUMES_BUCKET=resumes

# ------------------------------------------------------------------------------
# 4. Upstash Redis (Optional: For API rate limiting)
# Leave empty to bypass rate limiting in local development.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
